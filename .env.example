NEXT_PUBLIC_ADMIN_PASSWORD=replace-with-your-construction-password

# Canonical production site URL (used for metadata, canonical tags, sitemap)
NEXT_PUBLIC_SITE_URL=https://eastafricawholesalefoods.com

# Google Analytics 4 Measurement ID (loads gtag.js when set)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Tag Manager container ID (defaults to GTM-NDFMNF29 if unset)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
